#ifndef OO_LEGACY_GL
out vec4 FragColor;
  
in vec2 TexCoords;

uniform sampler2D imageIn;
uniform bool horizontal;

// 5x5 std dev 1.73
//uniform float weight[5] = float[] (0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);

// 5x5 std dev 3.0
//uniform float weight[5] = float[] (0.1527814864031109, 0.14459916754370944, 0.12258885125644112, 0.09309454217065882, 0.06332669582763516);

// 7x7 std dev 1.73
//uniform float weight[7] = float[] (0.22747085244225348, 0.1933606396808386, 0.11876031155562881, 0.052695618523727256, 0.016887608092075596, 0.003907714991571493, 0.0006526809350315506);

// 7x7 std dev 3.0
uniform float weight[7] = float[] (0.13649812722755, 0.12918787500405662, 0.10952340502389683, 0.08317258170844949, 0.05657737457255749, 0.03447396964662017, 0.018815730430644367);

const float radius = 1.2;

void main()
{             
	vec2 tex_offset = 1.0 / textureSize(imageIn, 0); // gets size of single texel
	vec3 result = texture(imageIn, TexCoords).rgb * weight[0]; // current fragment's contribution
	if(horizontal)
	{
		for(int i = 1; i < 7; ++i)
		{
			result += texture(imageIn, TexCoords + vec2(tex_offset.x * i * radius, 0.0)).rgb * weight[i];
			result += texture(imageIn, TexCoords - vec2(tex_offset.x * i * radius, 0.0)).rgb * weight[i];
		}
	}
	else
	{
		for(int i = 1; i < 7; ++i)
		{
			result += texture(imageIn, TexCoords + vec2(0.0, tex_offset.y * i * radius)).rgb * weight[i];
			result += texture(imageIn, TexCoords - vec2(0.0, tex_offset.y * i * radius)).rgb * weight[i];
		}
	}
	
	// at least one known OXP, DH nav buoy,  has an NaN issue resulting in black squares appearing on a
	// specific location on its main model during the blurring passes, so make sure to always check
	// against NaNs
	if(isnan(result.x) || isnan(result.y) || isnan(result.z))
	{
		// mark offending pixel in red
		FragColor = vec4(1.0, 0.0, 0.0, 1.0);
	}
	else
	{
		FragColor = vec4(result, 1.0);
	}
}
#else

// Legacy GLSL 1.20 port of the 7x7 std dev 3.0 Gaussian blur. The original
// used a uniform array initialized with an array constructor, textureSize()
// and isnan() — none of which exist in GLSL 1.20. The weights are now const
// scalars, the taps are unrolled, the texel size arrives as a uniform set
// from ObjC, and the NaN check uses x != x.
const float weight0 = 0.13649812722755;
const float weight1 = 0.12918787500405662;
const float weight2 = 0.10952340502389683;
const float weight3 = 0.08317258170844949;
const float weight4 = 0.05657737457255749;
const float weight5 = 0.03447396964662017;
const float weight6 = 0.018815730430644367;

const float radius = 1.2;

uniform sampler2D imageIn;
uniform bool horizontal;
uniform vec2 texelSize; // 1.0 / framebuffer size (replaces textureSize)

varying vec2 TexCoords;

#define BLUR_TAP(off, w)  result += texture2D(imageIn, TexCoords + (off)).rgb * (w);

void main()
{
	vec2 tex_offset = texelSize;
	vec3 result = texture2D(imageIn, TexCoords).rgb * weight0; // current fragment's contribution
	if(horizontal)
	{
		BLUR_TAP(vec2( tex_offset.x * 1.0 * radius, 0.0), weight1)
		BLUR_TAP(vec2(-tex_offset.x * 1.0 * radius, 0.0), weight1)
		BLUR_TAP(vec2( tex_offset.x * 2.0 * radius, 0.0), weight2)
		BLUR_TAP(vec2(-tex_offset.x * 2.0 * radius, 0.0), weight2)
		BLUR_TAP(vec2( tex_offset.x * 3.0 * radius, 0.0), weight3)
		BLUR_TAP(vec2(-tex_offset.x * 3.0 * radius, 0.0), weight3)
		BLUR_TAP(vec2( tex_offset.x * 4.0 * radius, 0.0), weight4)
		BLUR_TAP(vec2(-tex_offset.x * 4.0 * radius, 0.0), weight4)
		BLUR_TAP(vec2( tex_offset.x * 5.0 * radius, 0.0), weight5)
		BLUR_TAP(vec2(-tex_offset.x * 5.0 * radius, 0.0), weight5)
		BLUR_TAP(vec2( tex_offset.x * 6.0 * radius, 0.0), weight6)
		BLUR_TAP(vec2(-tex_offset.x * 6.0 * radius, 0.0), weight6)
	}
	else
	{
		BLUR_TAP(vec2(0.0,  tex_offset.y * 1.0 * radius), weight1)
		BLUR_TAP(vec2(0.0, -tex_offset.y * 1.0 * radius), weight1)
		BLUR_TAP(vec2(0.0,  tex_offset.y * 2.0 * radius), weight2)
		BLUR_TAP(vec2(0.0, -tex_offset.y * 2.0 * radius), weight2)
		BLUR_TAP(vec2(0.0,  tex_offset.y * 3.0 * radius), weight3)
		BLUR_TAP(vec2(0.0, -tex_offset.y * 3.0 * radius), weight3)
		BLUR_TAP(vec2(0.0,  tex_offset.y * 4.0 * radius), weight4)
		BLUR_TAP(vec2(0.0, -tex_offset.y * 4.0 * radius), weight4)
		BLUR_TAP(vec2(0.0,  tex_offset.y * 5.0 * radius), weight5)
		BLUR_TAP(vec2(0.0, -tex_offset.y * 5.0 * radius), weight5)
		BLUR_TAP(vec2(0.0,  tex_offset.y * 6.0 * radius), weight6)
		BLUR_TAP(vec2(0.0, -tex_offset.y * 6.0 * radius), weight6)
	}

	// at least one known OXP, DH nav buoy,  has an NaN issue resulting in black squares appearing on a
	// specific location on its main model during the blurring passes, so make sure to always check
	// against NaNs
	if(result.x != result.x || result.y != result.y || result.z != result.z)
	{
		// mark offending pixel in red
		gl_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
	}
	else
	{
		gl_FragColor = vec4(result, 1.0);
	}
}
#endif
