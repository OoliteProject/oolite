# Renderer layer for the move to SDL_GPU (issue #579).

oolite_sources += files(
    'OOFixedFunction.c',
    'OOGLStateCompat.m',
    'OOImmediateMode.c',
    'OORenderPass.c',
    'OORenderState.c',
    'OORenderStateMachine.c',
    'OORendererGL.c',
    'OORendererLog.m',
    'OORendererTexture.m',
    'OOVertexArray.c',
)

oolite_includes += include_directories('.')
