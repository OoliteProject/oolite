# Generated Meson configuration for sub-module: Scripting

# Files that do not use a JavaScript engine API, shared by both engines.
oolite_sources += files(
    'OOLegacyScriptWhitelist.m',
    'OOPListScript.m',
    'OOScript.m',
    'OOScriptTimer.m',
)

subdir('QuickJS')
oolite_includes += include_directories('QuickJS', '.')
