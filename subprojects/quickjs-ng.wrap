[wrap-git]
url = https://github.com/quickjs-ng/quickjs.git
revision = v0.17.0
depth = 1
# Oolite patches; see the comments in each file. 0001 and 0002 restore
# SpiderMonkey 1.8.5 behaviour that OXPs rely on (upstream request for an
# option instead: https://github.com/quickjs-ng/quickjs/issues/1837). 0003
# keeps -pthread out of Windows links, where clang warns that it is unused.
diff_files = quickjs-ng/0001-oolite-primitive-property-assignment.patch, quickjs-ng/0002-oolite-new-on-native-functions.patch, quickjs-ng/0003-oolite-no-pthread-on-windows.patch

[provide]
dependency_names = quickjs-ng
