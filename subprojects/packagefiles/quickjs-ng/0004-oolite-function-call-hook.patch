 /* return != 0 if the JS code needs to be interrupted */
 typedef int JSInterruptHandler(JSRuntime *rt, void *opaque);
 JS_EXTERN void JS_SetInterruptHandler(JSRuntime *rt, JSInterruptHandler *cb, void *opaque);
+/* Oolite: called when a bytecode function is entered (entering = true) and
+   left (entering = false), including each resumption and suspension of a
+   generator or async function. code identifies the function's bytecode, which
+   all closures of a function share. this_obj, argc and argv are only set on
+   entry to a call. Used by Oolite's JavaScript profiler. */
+typedef void JSFunctionCallHook(JSContext *ctx, JSValueConst func_obj,
+                                const void *code, JSValueConst this_obj,
+                                int argc, JSValueConst *argv, bool entering,
+                                void *opaque);
+JS_EXTERN void JS_SetFunctionCallHook(JSRuntime *rt, JSFunctionCallHook *cb, void *opaque);
+/* Oolite: the name, file name and first line of a bytecode function. Returns
+   false for other functions. The atoms must be freed. */
+JS_EXTERN bool JS_GetFunctionInfo(JSContext *ctx, JSValueConst func_obj,
+                                  JSAtom *name, JSAtom *filename, int *line_num);
