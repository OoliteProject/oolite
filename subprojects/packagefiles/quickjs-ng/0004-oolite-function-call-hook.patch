+bool JS_GetFunctionInfo(JSContext *ctx, JSValueConst func_obj,
+                        JSAtom *name, JSAtom *filename, int *line_num)
+{
+    JSObject *p;
+    JSFunctionBytecode *b;
+
+    if (JS_VALUE_GET_TAG(func_obj) != JS_TAG_OBJECT)
+        return false;
+    p = JS_VALUE_GET_OBJ(func_obj);
+    if (!js_class_has_bytecode(p->class_id))
+        return false;
+    b = p->u.func.function_bytecode;
+    *name = JS_DupAtom(ctx, b->func_name);
+    *filename = JS_DupAtom(ctx, b->filename);
+    *line_num = b->line_num;
+    return true;
+}
