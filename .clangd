# clangd (code completion, go-to-definition, diagnostics) for VS Code, Zed, CLion and others.
#
# clangd needs a compile database. ./mk.sh writes compile_commands.json at this directory's root
# each time it configures a build (the last flavour configured wins), and clangd reads it from
# there. On Windows run it from the MSYS2 UCRT64 shell (not Git Bash, whose bash breaks
# get_version.sh): ./mk.sh build debug. Use MSYS2's own clangd (ucrt64/bin/clangd.exe) so it
# finds the same headers the build does.
CompileFlags:
  CompilationDatabase: .
